# =============================================================================
# PROTOCOLO40 — variáveis de ambiente
# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# .env.local nunca vai para o Git.
# =============================================================================

# Supabase · Project Settings → API
# Estas duas vão para o navegador de propósito: a autorização é feita por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site. Em produção, o domínio final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SERVIDOR — nunca prefixe com NEXT_PUBLIC_ e nunca use no navegador.
# Ignora RLS. Só o worker de vídeo e rotinas administrativas precisam disto.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI (migrations) · Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=
# Senha do banco · Project Settings → Database
# Usada por `npm run db:push`, que dispensa o `supabase login` interativo.
SUPABASE_DB_PASSWORD=

# Analytics e pixel (opcionais).
# Sem estes valores nenhum script de terceiro é carregado.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Ligar a cobrança. Sem isto o produto é inteiro de graça e o paywall não
# existe — planos e assinatura continuam de pé, apenas desligados.
NEXT_PUBLIC_COBRANCA_ATIVA=

# Cobrança (opcional). Sem estas chaves a assinatura fica desligada e o
# admin ainda pode conceder plano à mão.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Notificações push (VAPID)
#
# Gere um par com:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# A pública vai para o navegador; a privada NUNCA sai do servidor.
# Sem elas o app roda inteiro — só não oferece notificação.
#
# Trocar o par invalida todas as inscrições existentes: quem já autorizou
# precisaria autorizar de novo. Gere uma vez e guarde.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
# quem recebe as reclamações do serviço de push
VAPID_SUBJECT=mailto:contato@p20x.com.br

# Segredo do cron que dispara os lembretes diários.
# A Vercel manda no header Authorization; sem isso qualquer um dispararia.
CRON_SECRET=
